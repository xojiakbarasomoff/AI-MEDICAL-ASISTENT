# Host-side config: for running the app or tools (e.g. `alembic`, `pytest`)
# directly on your machine against the Dockerized Postgres/Redis, which
# publish to these host ports (see docker-compose.yml). Postgres is on 5433,
# not 5432, to avoid colliding with any native PostgreSQL install already
# using 5432 on this machine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dental_ig_assistant
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=sk-your-key-here
